<Window x:Class="WhisperClaud.Windows.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verlauf &amp; Statistik" Width="960" Height="620" MinWidth="820" MinHeight="480">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <StackPanel Margin="0,0,28,0"><TextBlock x:Name="StatDictations" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Diktate" Foreground="Gray"/></StackPanel>
            <StackPanel Margin="0,0,28,0"><TextBlock x:Name="StatWords" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Wörter" Foreground="Gray"/></StackPanel>
            <StackPanel Margin="0,0,28,0"><TextBlock x:Name="StatWpm" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Ø Wörter/Min" Foreground="Gray"/></StackPanel>
            <StackPanel Margin="0,0,28,0"><TextBlock x:Name="StatSaved" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Gesparte Zeit" Foreground="Gray"/></StackPanel>
        </StackPanel>
        <TextBox DockPanel.Dock="Top" x:Name="Search" Margin="0,0,0,8" TextChanged="Search_TextChanged" ToolTip="Suchen"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="List" Grid.Column="0" SelectionChanged="List_SelectionChanged" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding FinalText}" TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap"/>
                            <TextBlock Foreground="Gray" FontSize="11">
                                <Run Text="{Binding Date, StringFormat='{}{0:dd.MM. HH:mm}', Mode=OneWay}"/> · <Run Text="{Binding AppName, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>
            <ScrollViewer Grid.Column="2">
                <StackPanel x:Name="Detail" Visibility="Collapsed" Margin="8,0,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Löschen" Click="Delete_Click" Padding="8,2"/>
                        <TextBlock x:Name="DetailMeta" Foreground="Gray" TextWrapping="Wrap"/>
                    </DockPanel>
                    <DockPanel Margin="0,12,0,4"><Button DockPanel.Dock="Right" Content="Kopieren" Click="CopyFinal_Click" Padding="8,2"/><TextBlock Text="Ergebnis" FontWeight="SemiBold"/></DockPanel>
                    <TextBox x:Name="DetailFinal" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" AcceptsReturn="True"/>
                    <DockPanel Margin="0,12,0,4"><Button DockPanel.Dock="Right" Content="Kopieren" Click="CopyRaw_Click" Padding="8,2"/><TextBlock Text="Rohtranskript" FontWeight="SemiBold"/></DockPanel>
                    <TextBox x:Name="DetailRaw" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" AcceptsReturn="True"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
