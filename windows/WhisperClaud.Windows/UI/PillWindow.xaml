<Window x:Class="WhisperClaud.Windows.UI.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperClaud" Width="620" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False">
    <Grid>
        <Border x:Name="Capsule" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="21" Height="42" Padding="16,0" Background="#D9000000" BorderBrush="#24FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#FF3B30" Margin="0,0,10,0"/>
                <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" Height="26" Margin="0,0,10,0"/>
                <TextBlock x:Name="Label" Foreground="White" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" MaxWidth="440" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
