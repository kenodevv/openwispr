<Window x:Class="WhisperClaud.Windows.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperClaud – Einstellungen" Width="640" Height="600" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Hint"><Setter Property="Foreground" Value="Gray"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style TargetType="TextBlock" x:Key="H"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
    </Window.Resources>
    <TabControl Margin="8">
        <TabItem Header="Test">
            <StackPanel Margin="12">
                <TextBlock Style="{StaticResource H}" Text="Jetzt testen"/>
                <TextBlock Style="{StaticResource Hint}" x:Name="TestHint"/>
                <TextBox x:Name="TestBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="TestStatus" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                <TextBlock x:Name="TestChecks" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Allgemein">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource H}" Text="Diktier-Taste"/>
                    <ComboBox x:Name="HotkeyBox" SelectionChanged="Any_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Halten = sprechen, loslassen = fertig. Kurz antippen startet Freisprechen. Hotkey + Shift mit markiertem Text = Befehlsmodus."/>
                    <ComboBox x:Name="ModeBox" SelectionChanged="Any_Changed"/>
                    <CheckBox x:Name="TapHandsFree" Content="Kurzes Antippen startet Freisprechen" Margin="0,8,0,0" Click="Any_Changed"/>
                    <CheckBox x:Name="AutoStop" Content="Freisprechen automatisch bei Stille beenden" Margin="0,4,0,0" Click="Any_Changed"/>
                    <DockPanel Margin="0,4,0,0"><TextBlock Text="Stille bis Stopp (s): " VerticalAlignment="Center"/><Slider x:Name="SilenceSlider" Minimum="1" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/></DockPanel>
                    <TextBlock Style="{StaticResource H}" Text="Audio &amp; Sprache"/>
                    <ComboBox x:Name="MicBox" SelectionChanged="Any_Changed"/>
                    <ComboBox x:Name="LanguageBox" Margin="0,6,0,0" SelectionChanged="Any_Changed"/>
                    <CheckBox x:Name="Sounds" Content="Start-/Stopp-Ton" Margin="0,8,0,0" Click="Any_Changed"/>
                    <TextBlock Style="{StaticResource H}" Text="Verhalten"/>
                    <CheckBox x:Name="ShowPillBox" Content="Schwebende Anzeige (Pill) zeigen" Click="Any_Changed"/>
                    <CheckBox x:Name="LaunchAtLogin" Content="Bei Anmeldung starten" Margin="0,4,0,0" Click="Any_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Formatierung">
            <StackPanel Margin="12">
                <TextBlock Style="{StaticResource H}" Text="Engine"/>
                <ComboBox x:Name="BackendBox" SelectionChanged="Backend_Changed"/>
                <StackPanel x:Name="ClaudePanel">
                    <TextBlock Style="{StaticResource H}" Text="Claude-API"/>
                    <PasswordBox x:Name="ApiKeyBox" ToolTip="API-Key (sk-ant-…)"/>
                    <TextBox x:Name="WorkspaceBox" Margin="0,6,0,0" ToolTip="Workspace-ID (wrkspc_…, nur bei Nutzer-Keys nötig)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Speichern" Click="SaveKey_Click" Padding="10,3"/>
                        <Button x:Name="TestButton" Content="Verbindung testen" Click="TestConnection_Click" Padding="10,3" Margin="8,0,0,0"/>
                        <TextBlock x:Name="KeyStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <TextBlock x:Name="TestResult" Style="{StaticResource Hint}"/>
                    <ComboBox x:Name="ModelBox" Margin="0,6,0,0" SelectionChanged="Any_Changed"/>
                    <ComboBox x:Name="EffortBox" Margin="0,6,0,0" SelectionChanged="Any_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Der Key wird mit Windows-DPAPI verschlüsselt gespeichert. Audio verlässt den PC nie, nur der Transkript-Text geht an Claude."/>
                </StackPanel>
                <StackPanel x:Name="OllamaPanel">
                    <TextBlock Style="{StaticResource H}" Text="Ollama (lokal, kostenlos)"/>
                    <TextBox x:Name="OllamaUrlBox" TextChanged="Any_Changed"/>
                    <TextBox x:Name="OllamaModelBox" Margin="0,6,0,0" TextChanged="Any_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Ollama von ollama.com installieren, dann in der Konsole: ollama pull qwen3:4b"/>
                </StackPanel>
                <CheckBox x:Name="ContextBox" Content="App-Kontext mitsenden (App, Fenstertitel, Text vor dem Cursor)" Margin="0,10,0,0" Click="Any_Changed"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Wörterbuch">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Begriff links, rechts optional typische Fehl-Transkriptionen (kommagetrennt)."/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="NewTerm" Width="200" ToolTip="Neuer Begriff"/>
                    <TextBox x:Name="NewMisspellings" Width="280" Margin="8,0,0,0" ToolTip="Wird oft verstanden als …"/>
                    <Button Content="Hinzufügen" Margin="8,0,0,0" Padding="10,3" Click="AddTerm_Click"/>
                </StackPanel>
                <ListBox x:Name="DictList" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Click="RemoveTerm_Click" Tag="{Binding}" Padding="6,0"/>
                                <TextBlock><Run FontWeight="SemiBold" Text="{Binding Term, Mode=OneWay}"/>  <Run Foreground="Gray" Text="{Binding MisspellingsText, Mode=OneWay}"/></TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
        <TabItem Header="Snippets">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Sprich den Auslöser, der gespeicherte Text wird eingefügt."/>
                <TextBox DockPanel.Dock="Top" x:Name="SnippetTrigger" ToolTip="Auslöser (gesprochen)"/>
                <TextBox DockPanel.Dock="Top" x:Name="SnippetContent" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,6" ToolTip="Text"/>
                <Button DockPanel.Dock="Top" Content="Snippet speichern" HorizontalAlignment="Right" Padding="10,3" Click="AddSnippet_Click" Margin="0,0,0,8"/>
                <ListBox x:Name="SnippetList" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Click="RemoveSnippet_Click" Tag="{Binding}" Padding="6,0"/>
                                <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Trigger, Mode=OneWay}"/><TextBlock Foreground="Gray" Text="{Binding Content, Mode=OneWay}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
        <TabItem Header="Datenschutz">
            <StackPanel Margin="12">
                <CheckBox x:Name="PrivacyBox" Content="Privatsphäre-Modus: keine Diktate speichern" Click="Any_Changed"/>
                <Button Content="Gesamten Verlauf löschen…" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3" Click="ClearHistory_Click"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0" Text="• Audio wird lokal mit Parakeet (ONNX) transkribiert und nie hochgeladen.&#10;• Nur das Transkript plus App-Name, Fenstertitel und bis zu 500 Zeichen vor dem Cursor gehen an Claude bzw. Ollama.&#10;• Passwortfelder werden erkannt und nicht diktiert.&#10;• Verlauf und Einstellungen liegen in %APPDATA%\WhisperClaud."/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
