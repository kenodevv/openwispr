<Window x:Class="OpenWispr.Windows.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWispr – Settings" Width="640" Height="600" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Hint"><Setter Property="Foreground" Value="Gray"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style TargetType="TextBlock" x:Key="H"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
    </Window.Resources>
    <TabControl Margin="8">
        <TabItem Header="Test">
            <StackPanel Margin="12">
                <TextBlock Style="{StaticResource H}" Text="Try it"/>
                <TextBlock Style="{StaticResource Hint}" x:Name="TestHint"/>
                <TextBox x:Name="TestBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="TestStatus" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                <TextBlock x:Name="TestChecks" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource H}" Text="Dictation key"/>
                    <ComboBox x:Name="HotkeyBox" SelectionChanged="Any_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Hold = speak, release = done. A quick tap starts hands-free mode. Hotkey + Shift with selected text = command mode."/>
                    <ComboBox x:Name="ModeBox" SelectionChanged="Any_Changed"/>
                    <CheckBox x:Name="TapHandsFree" Content="A quick tap starts hands-free mode" Margin="0,8,0,0" Click="Any_Changed"/>
                    <CheckBox x:Name="AutoStop" Content="End hands-free recording on silence" Margin="0,4,0,0" Click="Any_Changed"/>
                    <DockPanel Margin="0,4,0,0"><TextBlock Text="Silence before stop (s): " VerticalAlignment="Center"/><Slider x:Name="SilenceSlider" Minimum="1" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/></DockPanel>
                    <TextBlock Style="{StaticResource H}" Text="Audio &amp; language"/>
                    <ComboBox x:Name="MicBox" SelectionChanged="Any_Changed"/>
                    <ComboBox x:Name="LanguageBox" Margin="0,6,0,0" SelectionChanged="Any_Changed"/>
                    <CheckBox x:Name="Sounds" Content="Start/stop sound" Margin="0,8,0,0" Click="Any_Changed"/>
                    <TextBlock Style="{StaticResource H}" Text="Behavior"/>
                    <CheckBox x:Name="ShowPillBox" Content="Show floating pill" Click="Any_Changed"/>
                    <CheckBox x:Name="LaunchAtLogin" Content="Launch at login" Margin="0,4,0,0" Click="Any_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Cleanup">
            <StackPanel Margin="12">
                <TextBlock Style="{StaticResource H}" Text="Engine"/>
                <ComboBox x:Name="BackendBox" SelectionChanged="Backend_Changed"/>
                <StackPanel x:Name="ClaudePanel">
                    <TextBlock Style="{StaticResource H}" Text="Claude API"/>
                    <PasswordBox x:Name="ApiKeyBox" ToolTip="API key (sk-ant-…)"/>
                    <TextBox x:Name="WorkspaceBox" Margin="0,6,0,0" ToolTip="Workspace ID (wrkspc_…, only for user-scoped keys)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Save" Click="SaveKey_Click" Padding="10,3"/>
                        <Button x:Name="TestButton" Content="Test connection" Click="TestConnection_Click" Padding="10,3" Margin="8,0,0,0"/>
                        <TextBlock x:Name="KeyStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <TextBlock x:Name="TestResult" Style="{StaticResource Hint}"/>
                    <ComboBox x:Name="ModelBox" Margin="0,6,0,0" SelectionChanged="Any_Changed"/>
                    <ComboBox x:Name="EffortBox" Margin="0,6,0,0" SelectionChanged="Any_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="The key is stored encrypted with Windows DPAPI. Audio never leaves this PC; only the transcript text is sent to Claude."/>
                </StackPanel>
                <StackPanel x:Name="OllamaPanel">
                    <TextBlock Style="{StaticResource H}" Text="Ollama (local, free)"/>
                    <TextBox x:Name="OllamaUrlBox" TextChanged="Any_Changed"/>
                    <TextBox x:Name="OllamaModelBox" Margin="0,6,0,0" TextChanged="Any_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Install Ollama from ollama.com, then run: ollama pull qwen3:4b"/>
                </StackPanel>
                <CheckBox x:Name="ContextBox" Content="Send app context (app, window title, text before the cursor)" Margin="0,10,0,0" Click="Any_Changed"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Dictionary">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Term on the left, optional misheard variants on the right (comma-separated)."/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="NewTerm" Width="200" ToolTip="New term"/>
                    <TextBox x:Name="NewMisspellings" Width="280" Margin="8,0,0,0" ToolTip="Often misheard as …"/>
                    <Button Content="Add" Margin="8,0,0,0" Padding="10,3" Click="AddTerm_Click"/>
                </StackPanel>
                <ListBox x:Name="DictList" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Click="RemoveTerm_Click" Tag="{Binding}" Padding="6,0"/>
                                <TextBlock><Run FontWeight="SemiBold" Text="{Binding Term, Mode=OneWay}"/>  <Run Foreground="Gray" Text="{Binding MisspellingsText, Mode=OneWay}"/></TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
        <TabItem Header="Snippets">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Say the trigger and the stored text is inserted."/>
                <TextBox DockPanel.Dock="Top" x:Name="SnippetTrigger" ToolTip="Trigger (spoken)"/>
                <TextBox DockPanel.Dock="Top" x:Name="SnippetContent" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,6" ToolTip="Text"/>
                <Button DockPanel.Dock="Top" Content="Save snippet" HorizontalAlignment="Right" Padding="10,3" Click="AddSnippet_Click" Margin="0,0,0,8"/>
                <ListBox x:Name="SnippetList" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Click="RemoveSnippet_Click" Tag="{Binding}" Padding="6,0"/>
                                <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Trigger, Mode=OneWay}"/><TextBlock Foreground="Gray" Text="{Binding Content, Mode=OneWay}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
        <TabItem Header="Privacy">
            <StackPanel Margin="12">
                <CheckBox x:Name="PrivacyBox" Content="Privacy mode: do not store dictations" Click="Any_Changed"/>
                <Button Content="Delete entire history…" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3" Click="ClearHistory_Click"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0" Text="• Audio is transcribed locally with Parakeet (ONNX) and never uploaded.&#10;• Only the transcript plus app name, window title and up to 500 characters before the cursor are sent to Claude or Ollama.&#10;• Password fields are detected and skipped.&#10;• History and settings live in %APPDATA%\OpenWispr."/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
